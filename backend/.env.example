# Flask Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values for your target deployment environment

# Environment Mode: 'development' or 'production'
FLASK_ENV=production

# Application Secret Key for Session Security
SECRET_KEY=your_production_secret_key_here

# Database Connection URI (MySQL / PyMySQL)
# Format: mysql+pymysql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>
DATABASE_URL=mysql+pymysql://db_user:db_password@localhost:3306/traffic_management

# Server Listening Port
PORT=5000

# Allowed CORS Origins (comma-separated URLs, or * for all)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
